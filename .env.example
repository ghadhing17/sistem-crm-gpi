# =============================================================================
# CRM Graha Padma — Environment Variables
# Salin file ini ke `.env` dan isi nilainya.
# JANGAN pernah commit file `.env` ke Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Untuk local development, nilai ini sudah sesuai dengan docker-compose.yml
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/crm_graha_padma

# -----------------------------------------------------------------------------
# Auth (NextAuth / Auth.js)
# Generate NEXTAUTH_SECRET dengan: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# -----------------------------------------------------------------------------
# Enkripsi data sensitif (AES-256-GCM via Node.js crypto)
# Generate dengan: openssl rand -hex 32
# Digunakan untuk enkripsi kolom KTP/NPWP di database
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=ganti-dengan-hex-key-32-bytes-64-karakter

# -----------------------------------------------------------------------------
# Upload files
# Path folder di luar direktori publik Next.js
# -----------------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=5

# -----------------------------------------------------------------------------
# Integrasi eksternal (isi saat fase 3 — Otomasi & Integrasi)
# -----------------------------------------------------------------------------
# WHATSAPP_BUSINESS_API_TOKEN=
# META_LEAD_ADS_VERIFY_TOKEN=
# META_LEAD_ADS_APP_SECRET=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
